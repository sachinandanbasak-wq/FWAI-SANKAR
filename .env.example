# Copy this file to ".env" (same folder) and change the two secrets.
#
#   Copy-Item .env.example .env
#
# The Prisma CLI and the Next.js app both read ".env".
# ".env" is git-ignored, so real secrets never get committed.

# Local database (SQLite). To move to Supabase/Neon Postgres, change the
# datasource provider in prisma/schema.prisma to "postgresql" and put the
# connection string here.
DATABASE_URL="file:./dev.db"

# Admin login password for /admin. CHANGE THIS before any real use.
ADMIN_PASSWORD="change-me-admin"

# Secret used to sign the admin session cookie. CHANGE THIS to a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"
